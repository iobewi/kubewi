{
  "name": "kubewi-sdk",
  "dockerComposeFile": "./compose.yaml",
  "service": "kubewi-sdk-manager",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "ms-python.python",
        "timonwong.shellcheck"
      ]
    }
  },
  "remoteEnv": {
    "HOST_WORKSPACE_PATH": "${localWorkspaceFolder}"
  }
}
