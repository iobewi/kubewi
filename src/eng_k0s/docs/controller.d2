direction: down

controller: {
  label: "Controller Node"
  style.fill: "#dce8f2"
  style.stroke: "#5f7ea3"
  style.border-radius: 10
  style.font-size: 16

  k0s: {
    label: "k0s controller"
    style.fill: "#c2d3e5"
    style.stroke: "#6483a8"
    style.border-radius: 8
    style.font-size: 15
    grid-rows: 1
    grid-columns: 3

    api: "API server\n:6443" {
      style.fill: "#dce8f2"
      style.stroke: "#5f7ea3"
      style.border-radius: 6
      style.font-size: 13
    }
    dns: "CoreDNS" {
      style.fill: "#dce8f2"
      style.stroke: "#5f7ea3"
      style.border-radius: 6
      style.font-size: 13
    }
    cilium: "Cilium\n(helm)" {
      style.fill: "#dce8f2"
      style.stroke: "#5f7ea3"
      style.border-radius: 6
      style.font-size: 13
    }
  }

  registry: "Distribution\nregistry:2\n192.168.42.1:5000" {
    style.fill: "#e8f0e0"
    style.stroke: "#7a9e5f"
    style.border-radius: 6
    style.font-size: 13
  }

  token: "worker-token\n/etc/k0s/" {
    style.fill: "#ede9e2"
    style.stroke: "#b8a98a"
    style.border-radius: 6
    style.font-size: 13
  }
}

workers: {
  label: "Worker Nodes"
  style.fill: "#eaeff5"
  style.stroke: "#7c96b1"
  style.border-radius: 10
  style.font-size: 15
  style.stroke-dash: 4
}

controller.k0s.api -> workers: "VLAN 220 — 192.168.22.0/24" {
  style.stroke: "#6483a8"
  style.font-size: 12
}
controller.registry -> workers: "VLAN 420 — 192.168.42.0/24" {
  style.stroke: "#7a9e5f"
  style.font-size: 12
}
controller.token -> workers: "join token" {
  style.stroke-dash: 4
  style.stroke: "#b8a98a"
  style.font-size: 12
}
