apiVersion: k0s.k0sproject.io/v1beta1
kind: ClusterConfig
metadata:
  name: k0s
spec:
  api:
    address: {{ k0s_api_address }}
    k0sApiPort: 9443
    port: 6443
  network:
    podCIDR: {{ k0s_pod_cidr }}
    serviceCIDR: {{ k0s_service_cidr }}
    provider: custom
  extensions:
    helm:
      repositories:
        - name: cilium
          url: https://helm.cilium.io/
      charts:
        - name: cilium
          chartname: cilium/cilium
          version: "{{ k0s_cilium_version }}"
          namespace: kube-system
          values: |
            kubeProxyReplacement: true
            k8sServiceHost: {{ k0s_api_address }}
            k8sServicePort: 6443
            operator:
              replicas: 1
  telemetry:
    enabled: false
