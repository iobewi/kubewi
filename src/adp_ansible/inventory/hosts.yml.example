all:
  children:

    kubernetes:
      children:

        controllers:
          children:

            # Un gateway est un controller exposé sur le LAN externe
            # (routage, NAT, WireGuard, VLANs)
            gateways:
              hosts:
                controller-01:
                  ansible_host: 10.0.100.1        # IP WireGuard fixe (après init)
                  ansible_user: iobewi
                  init_host: "192.168.x.x"        # IP DHCP eth0 — premier run uniquement
                  host_id: 1                       # dérive : 192.168.22.1, .42.1, .62.1
                  network_external_iface: eth0
                  network_bridge_members:
                    - eth1
                  network_provisioning_ip: "192.168.0.1/24"
                  # Requis — généré par : kubewi vpn generate-keys
                  wg_controller_pubkey: ""
                  wg_sdk_pubkey: ""

                  # Optionnel — WiFi AP (hostapd)
                  # Décommenter pour activer le point d'accès WiFi
                  # Mutuellement exclusif avec network_wifi sur la même interface
                  # wifi_ap:
                  #   iface: wlan0
                  #   bridge: br-wifi
                  #   vlan_id: 220
                  #   ssid: kubewi
                  #   passphrase: "{{ vault_wifi_ap_psk }}"
                  #   hw_mode: g      # g = 2.4 GHz, a = 5 GHz
                  #   channel: 6
                  #   country: FR

                  # Optionnel — WiFi client (wpa_supplicant)
                  # Décommenter si le gateway se connecte lui-même en WiFi
                  # network_wifi:
                  #   iface: wlan0
                  #   ssid: "{{ vault_wifi_ssid }}"
                  #   psk: "{{ vault_wifi_psk }}"

        workers:
          vars:
            ansible_ssh_common_args: '-o ProxyJump=iobewi@10.0.100.1 -o StrictHostKeyChecking=no'
          hosts:
            # Les workers sont ajoutés automatiquement par : kubewi cluster apply
            # Exemple de worker (décommenter et adapter) :
            # worker-01:
            #   ansible_host: 192.168.22.10      # VLAN 220, après provisioning
            #   ansible_user: iobewi
            #   init_host: "192.168.0.x"         # DHCP provisioning, premier run uniquement
            #   network_bridge_members:
            #     - eth0
            #     - eth1
