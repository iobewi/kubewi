direction: down

controller: {
  label: "Controller Node"
  style.fill: "#dce8f2"
  style.stroke: "#5f7ea3"
  style.border-radius: 10
  style.font-size: 15

  token: "worker-token\n/etc/k0s/" {
    style.fill: "#ede9e2"
    style.stroke: "#b8a98a"
    style.border-radius: 6
    style.font-size: 13
  }

  api: "API server\n:6443" {
    style.fill: "#dce8f2"
    style.stroke: "#5f7ea3"
    style.border-radius: 6
    style.font-size: 13
  }
}

worker: {
  label: "Worker Node"
  style.fill: "#e8f2e8"
  style.stroke: "#5f9e5f"
  style.border-radius: 10
  style.font-size: 16

  k0s: {
    label: "k0s worker"
    style.fill: "#c8e5c8"
    style.stroke: "#5f9e5f"
    style.border-radius: 8
    style.font-size: 15
    grid-rows: 1
    grid-columns: 3

    kubelet: "kubelet" {
      style.fill: "#e8f2e8"
      style.stroke: "#5f9e5f"
      style.border-radius: 6
      style.font-size: 13
    }
    containerd: "containerd" {
      style.fill: "#e8f2e8"
      style.stroke: "#5f9e5f"
      style.border-radius: 6
      style.font-size: 13
    }
    cilium: "Cilium\nagent" {
      style.fill: "#e8f2e8"
      style.stroke: "#5f9e5f"
      style.border-radius: 6
      style.font-size: 13
    }
  }
}

controller.token -> worker.k0s: "slurp + delegate_to" {
  style.stroke-dash: 4
  style.stroke: "#b8a98a"
  style.font-size: 12
}

worker.k0s -> controller.api: "VLAN 220 — 192.168.22.1:6443" {
  style.stroke: "#6483a8"
  style.font-size: 12
}
