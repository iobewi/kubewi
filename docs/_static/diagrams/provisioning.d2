direction: right

controller: {
  label: "Controller Node"
  style.fill: "#dce8f2"
  style.stroke: "#5f7ea3"
  style.border-radius: 10
  style.font-size: 18
  grid-rows: 3
  grid-columns: 1

  system: "OS / systemd / SSH / chrony" {
    style.fill: "#ececf0"
    style.stroke: "#9aa9b8"
    style.border-radius: 8
    style.font-size: 15
  }
  network: "interfaces / bridge / VLAN / routage" {
    style.fill: "#c9d8e8"
    style.stroke: "#6e8fb3"
    style.border-radius: 8
    style.font-size: 15
  }
  runtime: "containerd + k0s" {
    style.fill: "#c2d3e5"
    style.stroke: "#6483a8"
    style.border-radius: 8
    style.font-size: 15
  }
}

workers: {
  label: "Worker Nodes"
  style.fill: "#eaeff5"
  style.stroke: "#7c96b1"
  style.border-radius: 10
  style.font-size: 18
  direction: down

  motion: {
    label: "Motion Worker"
    style.fill: "#e2eaf4"
    style.stroke: "#7c96b1"
    style.border-radius: 8
    style.font-size: 16
    grid-rows: 1
    grid-columns: 3
    system: "OS / systemd / SSH / chrony" { style.fill: "#ececf0"; style.stroke: "#9aa9b8"; style.border-radius: 6; style.font-size: 13 }
    network: "interfaces / bridge / VLAN" { style.fill: "#c9d8e8"; style.stroke: "#6e8fb3"; style.border-radius: 6; style.font-size: 13 }
    runtime: "containerd + k0s" { style.fill: "#c2d3e5"; style.stroke: "#6483a8"; style.border-radius: 6; style.font-size: 13 }
  }

  perception: {
    label: "Perception Worker"
    style.fill: "#e2eaf4"
    style.stroke: "#7c96b1"
    style.border-radius: 8
    style.font-size: 16
    grid-rows: 1
    grid-columns: 3
    system: "OS / systemd / SSH / chrony" { style.fill: "#ececf0"; style.stroke: "#9aa9b8"; style.border-radius: 6; style.font-size: 13 }
    network: "interfaces / bridge / VLAN" { style.fill: "#c9d8e8"; style.stroke: "#6e8fb3"; style.border-radius: 6; style.font-size: 13 }
    runtime: "containerd + k0s" { style.fill: "#c2d3e5"; style.stroke: "#6483a8"; style.border-radius: 6; style.font-size: 13 }
  }

  edge: {
    label: "Edge Worker"
    style.fill: "#e2eaf4"
    style.stroke: "#7c96b1"
    style.border-radius: 8
    style.font-size: 16
    grid-rows: 1
    grid-columns: 3
    system: "OS / systemd / SSH / chrony" { style.fill: "#ececf0"; style.stroke: "#9aa9b8"; style.border-radius: 6; style.font-size: 13 }
    network: "interfaces / bridge / VLAN" { style.fill: "#c9d8e8"; style.stroke: "#6e8fb3"; style.border-radius: 6; style.font-size: 13 }
    runtime: "containerd + k0s" { style.fill: "#c2d3e5"; style.stroke: "#6483a8"; style.border-radius: 6; style.font-size: 13 }
  }
}

